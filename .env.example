# app/.env 로 복사해서 쓴다. .env 는 커밋하지 않는다(.gitignore). 이 파일에는 키 값을 적지 않는다.

# ── 지금 필요한 키 ─────────────────────────────────────────────
# 공공데이터포털 15132686 '국내 반입차단 대상 원료·성분' API 키 = 성분 대조에 쓰는 원료 목록.
# 비우면 data/mfds/ 에 저장해 둔 목록 사본(식품안전나라 웹 목록)을 쓴다.
DATA_GO_KR_KEY=

# ── Zoro-1 판정 서버 ──────────────────────────────────────────
# mock: 녹화 응답 + 합성 확률(서버 불필요) | remote: 판정 서버 | record: 판정 서버 + 응답 녹화
ZORO_MODE=mock
# 판정 서버 주소. 쉼표로 백업 서버를 이어 적으면 앞에서부터 시도
ZORO_URL=
# 판정 서버에 X-API-Key 를 켰을 때만
ZORO_API_KEY=
ZORO_TIMEOUT=30
# S2 전용 읽기 한도. timeout/504/524 뒤에는 request_id 서버 로그를 확인하고 중복 생성하지 않는다.
ZORO_REASONING_TIMEOUT=120
ZORO_RETRIES=3
# 서버별 총 시도 수는 위 ZORO_RETRIES. 503/시간초과 뒤 기본 2초, 4초 대기(실측·실패 원장 보존).
ZORO_RETRY_BACKOFF=2
# 긴 추론은 기본 끔. 1로 켜도 완료/절단 검증과 S2 timeout 중복 생성 금지는 그대로.
NEXTASK_SYSTEM2=0
# 로컬 응답 녹화 경로(상품 입력 포함; 저장소 미포함). 비우면 기본 recordings/zoro.jsonl
# ZORO_RECORDINGS=logs/recordings/zoro.jsonl
# S2 완료는 answers_source=reasoned + finish_reason=stop + cut 없음으로 확인한다.
# 절단/direct 복귀/구서버 메타 누락은 이전 S1 유지 후 도구·사람 경로. HTTP 200은 완료 증거 아님.

# ── 선택 ──────────────────────────────────────────────────────
# 식품안전나라 I2715 '해외직구 위해식품 차단정보'(제품 목록) 키. 선택. '이 제품 자체의 차단 이력' 확인에 쓴다.
# 평소에는 고정 사본(아래 MFDS_I2715_FILE)을 쓰고, MFDS_LIVE=1 이거나 사본이 없을 때만 이 키로 실시간 조회한다.
MFDS_API_KEY=
# 원료 목록 파일 경로를 직접 지정할 때만(보통 비움). 비우면 data/mfds/snapshot/registry_*.json(가장 최근 고정본)
MFDS_BLOCKLIST=
# 제품 목록(I2715) 파일. 비우면 data/mfds/I2715-*.csv(식품안전나라 내려받기) → snapshot/i2715_*.json 순
MFDS_I2715_FILE=
# 1 이면 고정본 대신 실시간 API(원료 목록·I2715). 영상·평가는 비워 두어 결과를 고정한다
MFDS_LIVE=
# OCR 엔진(앞에서부터 시도): sidecar(녹화) | remote(판정 서버 OCR) | tesseract | 패키지.모듈:클래스
OCR_ENGINE=sidecar,remote,tesseract
# 선택 외부 조회: DSLD 라벨 검색, PubChem 동의어. A 다음 행동의 DSLD/FDA 조회는 별도 캐시·실제 API를 사용.
DSLD_LIVE=0
PUBCHEM_LIVE=0
# 비교용 고정 파이프라인(모든 결정에 System 2·도구). 보통 비움
FIXED_PIPELINE=
# 성분표 부족 시 다음 행동: agent(기본) | fixed(대조) | off(기존 경로)
NEXT_POLICY=agent
# 판단 미달 뒤 제한된 생성·도구 회수. 실모델/표면 인수 전 기본 OFF.
NEXTASK_AGENT_RECOVERY=0
# 사이트 무관 선언/갤러리 선택. 0이어도 위험한 첫 사진 자동채택으로 되돌리지 않는다.
NEXTASK_SITE_GENERIC=1
# 검증한 316개 원료 버전의 후보 검색: 0=끔, shadow=기록만, 1=후보+독립근거 가드. 참고 이름은 확정 근거 아님.
NEXTASK_INGREDIENT_KB=0
# 로그·장부는 로컬 전용. 필요할 때만 경로를 지정한다
# NEXTASK_LOG_DIR=logs
# NEXTASK_STORE=data/store.json
# 주제 플러그인 (nextask/core/plugins/<이름>.py)
NEXTASK_PLUGIN=supplement

# ── 쓰지 않음 ────────────────────────────────────────────────
# (P2) 국내 판매 현황 탭: 네이버 쇼핑 검색 API 는 2026-07-31 종료라 쓰지 않음. 키를 넣지 않는다
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
