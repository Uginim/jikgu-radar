# infra/.env 로 복사해서 채운다. .env 는 커밋 금지(.gitignore 에 있음)
# Hugging Face 읽기 토큰 (Zoro-1 은 gated). 웨이트를 HF 에서 받을 때만 필요
HF_TOKEN=
# 웨이트 위치. 비우면 infra/weights/zoro1. Mac 백업은 기존 경로를 그대로 쓰면 다운로드가 필요 없다:
# ZORO_MODEL_DIR=/path/to/zoro1
ZORO_MODEL_DIR=
# HF 리비전 고정 (2026-11-18 로컬에 받은 main)
ZORO_REVISION=bf1b76b9b4df03b05fcbb73444e1cd4db0f566da
ZORO_PORT=30001
# 서버 이름: 로그·응답에 찍혀 어느 서버가 답했는지 구분 (brev-l40s / mac-backup)
ZORO_SERVER_NAME=primary
# 비우면 인증 없음. 채우면 X-API-Key 헤더 필요 (공개 URL 남용 방지)
ZORO_API_KEY=
# 모델 잠금 대기 한도(초). 넘으면 503 -> 클라이언트가 재시도/백업 전환
ZORO_QUEUE_TIMEOUT=20
# 1 이면 reasoning(생성, 수십 초) 허용. 데모 기본은 0
ZORO_ALLOW_REASONING=0
# 터널: quick (trycloudflare, 계정 불필요) | none
ZORO_TUNNEL=quick
# 클라이언트(에이전트)용: 앞에서부터 시도할 서버 목록
ZORO_URLS=http://127.0.0.1:30001
ZORO_TIMEOUT=30
ZORO_RETRIES=3
# OCR: 1 이면 GravityOCR-KO 를 같은 GPU 에 함께 올리고 /v1/ocr 을 연다 (VRAM +2.2GB 이상)
ZORO_OCR=1
ZORO_OCR_REVISION=6c749d417879037da8a1f6af4cf9aaa7632308bc
# /v1/generate 한 번에 생성할 최대 토큰
ZORO_GEN_MAX_TOKENS=512
